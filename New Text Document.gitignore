<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Facebook Inspired Layout</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Segoe UI,sans-serif;
}

body{
    background:#f0f2f5;
}

/* NAVBAR */
.navbar{
    height:60px;
    background:#fff;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 20px;
    box-shadow:0 1px 4px rgba(0,0,0,.1);
    position:fixed;
    width:100%;
    top:0;
    z-index:1000;
}

.logo{
    color:#1877f2;
    font-size:2rem;
    font-weight:bold;
}

.search{
    width:300px;
    padding:10px;
    border:none;
    border-radius:30px;
    background:#f0f2f5;
}

.nav-icons{
    display:flex;
    gap:20px;
    font-size:1.4rem;
}

/* MAIN */
.main{
    margin-top:70px;
    display:grid;
    grid-template-columns:280px 1fr 320px;
    gap:20px;
    padding:20px;
}

/* LEFT */
.sidebar{
    position:sticky;
    top:80px;
}

.menu-item{
    padding:12px;
    border-radius:10px;
    cursor:pointer;
}

.menu-item:hover{
    background:#e4e6eb;
}

/* CENTER */
.feed{
    max-width:700px;
    margin:auto;
}

.post{
    background:white;
    border-radius:15px;
    margin-bottom:20px;
    overflow:hidden;
    box-shadow:0 2px 6px rgba(0,0,0,.08);
}

.post-header{
    padding:15px;
    display:flex;
    align-items:center;
    gap:10px;
}

.avatar{
    width:45px;
    height:45px;
    border-radius:50%;
    background:#1877f2;
}

.username{
    font-weight:600;
}

.post img{
    width:100%;
    display:block;
}

.post-actions{
    padding:15px;
    display:flex;
    gap:25px;
    border-top:1px solid #ddd;
}

/* RIGHT */
.widgets{
    position:sticky;
    top:80px;
}

.card{
    background:white;
    border-radius:15px;
    padding:15px;
    margin-bottom:15px;
    box-shadow:0 2px 6px rgba(0,0,0,.08);
}

.sponsor{
    height:160px;
    background:#ddd;
    border-radius:10px;
    display:flex;
    align-items:center;
    justify-content:center;
}

/* MOBILE */
@media(max-width:1100px){

.main{
    grid-template-columns:1fr;
}

.sidebar,
.widgets{
    display:none;
}

.feed{
    width:100%;
}
}
</style>
</head>
<body>

<div class="navbar">
